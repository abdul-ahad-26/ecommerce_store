# Frontend environment (Next.js)
#
# IMPORTANT: NEXT_PUBLIC_* vars are baked into the build. After changing any of
# these on Vercel you must REDEPLOY (a save alone won't take effect).

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public site origin — used for absolute URLs in metadata, sitemap & share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Store contact details (shown on contact page, footer, share buttons) ---
# WhatsApp number: country code + number, digits only (no +, spaces or dashes).
NEXT_PUBLIC_CONTACT_WHATSAPP=920000000000
NEXT_PUBLIC_CONTACT_PHONE=+92 000 0000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@meher.pk
# Optional — leave blank to hide Instagram links.
NEXT_PUBLIC_INSTAGRAM_URL=
