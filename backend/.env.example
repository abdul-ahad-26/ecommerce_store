# --- App ---
PROJECT_NAME="Ecommerce Store API"
ENVIRONMENT=development
DEBUG=true
# Log every SQL statement (very verbose) — handy when debugging queries.
SQL_ECHO=false

# --- Database (Neon / Postgres) ---
# Use the async driver prefix: postgresql+asyncpg://
# Get this from your Neon dashboard (the pooled connection string is fine).
# Neon's ?sslmode=require&channel_binding=require params are handled
# automatically (stripped + SSL re-applied), so you can paste the URL as-is —
# just change the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME

# --- Seed data (used by seed.py) ---
# Avoid reserved TLDs (.test/.example) — EmailStr rejects them.
ADMIN_EMAIL=admin@store.pk
ADMIN_PASSWORD=admin12345

# --- Auth / JWT ---
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie config — keep these defaults for local dev.
# In production (HTTPS, cross-site): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) — order confirmations + password resets ---
# Leave RESEND_API_KEY empty to disable email entirely (sends become no-ops).
# Get a key at https://resend.com. EMAIL_FROM must use a Resend-verified domain
# (or the shared onboarding@resend.dev for testing).
RESEND_API_KEY=
EMAIL_FROM="Meher <onboarding@resend.dev>"
# Store owner's inbox for new-order alerts. Empty = no owner alert.
ADMIN_NOTIFICATION_EMAIL=
# Public storefront URL used to build links in emails (reset link, order page).
FRONTEND_URL=http://localhost:3000

# --- AI shopping assistant ---
# Set ASSISTANT_ENABLED=false to turn the assistant off (endpoints return 503).
ASSISTANT_ENABLED=true
# Active model. Keys are defined in app/services/assistant/models.py REGISTRY:
#   openai:gpt-4.1-mini | openai:gpt-4.1-nano | openai:gpt-4o-mini
#   groq:llama-3.3-70b  | groq:gpt-oss-120b
ASSISTANT_MODEL=openai:gpt-4.1-mini
# Dev: let a request override the model (for A/B comparison). Set false in prod.
ASSISTANT_ALLOW_MODEL_OVERRIDE=true
ASSISTANT_MAX_TURNS=8
ASSISTANT_MAX_HISTORY=20
# Log the agent's steps + every tool call to the server console (dev only).
ASSISTANT_VERBOSE=true
# Cap a single reply's output tokens (bounds cost + blunts off-topic abuse).
ASSISTANT_MAX_TOKENS=700
# Per-IP request budget per minute on the chat endpoints (0 = disabled).
ASSISTANT_RATE_LIMIT_PER_MIN=20
# Provider keys (either may be empty). OpenAI enables the tracing dashboard at
# https://platform.openai.com/traces ; Groq (https://console.groq.com) is a
# free OpenAI-compatible alternative for comparison.
OPENAI_API_KEY=
GROQ_API_KEY=
