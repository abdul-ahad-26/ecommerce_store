# --- App ---
PROJECT_NAME="Ecommerce Store API"
ENVIRONMENT=development
DEBUG=true
# Log every SQL statement (very verbose) — handy when debugging queries.
SQL_ECHO=false

# --- Database (Neon / Postgres) ---
# Use the async driver prefix: postgresql+asyncpg://
# Get this from your Neon dashboard (the pooled connection string is fine).
# Neon's ?sslmode=require&channel_binding=require params are handled
# automatically (stripped + SSL re-applied), so you can paste the URL as-is —
# just change the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME

# --- Seed data (used by seed.py) ---
# Avoid reserved TLDs (.test/.example) — EmailStr rejects them.
ADMIN_EMAIL=admin@store.pk
ADMIN_PASSWORD=admin12345

# --- Auth / JWT ---
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie config — keep these defaults for local dev.
# In production (HTTPS, cross-site): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
